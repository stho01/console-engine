<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>15</LangVersion>
        <RootNamespace>TerraForM.Ecs</RootNamespace>
        <AssemblyName>TerraForM.Ecs</AssemblyName>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ConsoleEngine\ConsoleEngine.csproj" />
      <ProjectReference Include="..\..\Libs\Microsoft.Xna.Framework\Microsoft.Xna.Framework.csproj" />
    </ItemGroup>

    <!-- Shared with Examples/TerraForM instead of copied: the same screens, texts and maps. -->
    <ItemGroup>
      <Compile Include="..\TerraForM\Assets\SpritePaths.cs" Link="Assets\SpritePaths.cs" />
      <Compile Include="..\TerraForM\Assets\Texts\HudTexts.cs" Link="Assets\Texts\HudTexts.cs" />
      <None Include="..\TerraForM\Assets\Maps\*.txt" Link="Assets\Maps\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest" />
      <None Include="..\TerraForM\Assets\Sprites\*.sprite" Link="Assets\Sprites\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
