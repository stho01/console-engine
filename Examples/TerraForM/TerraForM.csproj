<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <RootNamespace>TerraForM</RootNamespace>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ConsoleEngine\ConsoleEngine.csproj" />
  </ItemGroup>

  <!-- Every data file under Assets/ goes next to the exe, where GameBase.Assets reads it. The .cs files there are
       Compile items, not None, so they are not copied. -->
  <ItemGroup>
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
